# Bellu Cloud Lab — DEDICATED test-account credentials.
#
# This file is SEPARATE from the main Bellu stack's deploy/.env on purpose: the
# lab provisions intentionally-insecure resources (e.g. a security group open to
# 0.0.0.0/0) and MUST run only in an isolated, throwaway test account — never
# the account Bellu itself uses.
#
# Copy to .env (gitignored) and fill in the test-account values:
#   cp bellu-cloud-lab/.env.example bellu-cloud-lab/.env
#
# NEVER commit the real .env. Credentials live here only, not in Terraform or
# scenario files (Requirement 12.1).

# Dedicated test-account AWS credentials (NOT the Bellu production identity).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, for temporary/assumed-role credentials:
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Which Bellu control-panel API the runner queries after `bellu run`.
BELLU_API_URL=http://localhost:8080
BELLU_ADMIN_EMAIL=admin@bellu.local
BELLU_ADMIN_PASSWORD=admin12345
