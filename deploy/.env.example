# Bellu deploy environment. Copy to deploy/.env (gitignored) and fill in.
# Docker Compose automatically reads deploy/.env.

# --- Cloud Connector: Bellu's own AWS identity (the bellu-connector user) ---
# These two are SECRET. Do not commit them. Put the real values in deploy/.env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Non-secret connector settings.
BELLU_CONNECTOR_PRINCIPAL_ARN=arn:aws:iam::001018342000:user/bellu-connector
BELLU_CONNECTOR_TEMPLATE_BUCKET=bellu-templates-001018342000
BELLU_CONNECTOR_TEMPLATE_REGION=us-east-1
BELLU_CONNECTOR_LINK_TTL_MIN=60

# Scheduled re-discovery. Leave empty to scan only when you click "discover".
# Set a Go duration (minimum 15m), e.g. 6h, to re-scan idle connections on a
# timer; this keeps the graph and Amazon Inspector vulnerabilities current.
# Each scan costs AWS API calls, and Inspector must be enabled in the account
# for vulnerabilities to appear.
BELLU_DISCOVERY_INTERVAL=
BELLU_DISCOVERY_MAX_CONCURRENT=2

# --- GitHub App integration ---
# Register a GitHub App (Settings -> Developer settings -> GitHub Apps), then
# fill these in. App ID and slug are NOT secret; the private key and webhook
# secret ARE — keep them only in deploy/.env (gitignored) and the mounted .pem.
#
# Leave BELLU_GITHUB_APP_ID empty to keep the GitHub integration disabled.
BELLU_GITHUB_APP_ID=
BELLU_GITHUB_APP_SLUG=

# Private key: download the .pem from the App page, save it OUTSIDE git (e.g.
# deploy/secrets/github-app-key.pem — that path is gitignored), and point this
# at it. It is mounted read-only into the container at /run/secrets.
BELLU_GITHUB_APP_KEY_FILE=./secrets/github-app-key.pem

# Webhook secret: the same random string you enter in the App's Webhook config.
# Generate one with:  openssl rand -hex 32
BELLU_GITHUB_WEBHOOK_SECRET=

# Where the install callback redirects the browser back to. Use your public URL.
BELLU_FRONTEND_BASE_URL=http://13.204.68.244

# Override only for GitHub Enterprise Server (defaults to github.com).
# BELLU_GITHUB_API_BASE=https://api.github.com
