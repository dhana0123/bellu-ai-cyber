# Build the React control panel and serve it with nginx. nginx also proxies
# /api to the bellu-api container so the browser talks to a single origin.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ ./
# Dev/demo builds can reveal the Preview (mock) add-on modules. Default off.
ARG VITE_SHOW_PREVIEW=false
ENV VITE_SHOW_PREVIEW=$VITE_SHOW_PREVIEW
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Ship both config templates; the entrypoint picks HTTP-only or HTTPS at boot
# depending on whether a TLS certificate is mounted. This keeps the image able
# to start cleanly before a cert exists (so certbot can run) and after.
COPY deploy/nginx.http.conf /etc/nginx/templates/nginx.http.conf
COPY deploy/nginx.https.conf /etc/nginx/templates/nginx.https.conf
COPY deploy/frontend-entrypoint.sh /docker-entrypoint-select.sh
RUN chmod +x /docker-entrypoint-select.sh
EXPOSE 80 443
ENTRYPOINT ["/docker-entrypoint-select.sh"]
CMD ["nginx", "-g", "daemon off;"]
