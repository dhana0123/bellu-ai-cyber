# Build the bellu-api control-panel server.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/bellu-api ./backend/cmd/bellu-api

FROM alpine:3.20
RUN adduser -D -u 10001 bellu
WORKDIR /app
COPY --from=build /out/bellu-api /usr/local/bin/bellu-api
COPY bellu.yaml /app/bellu.yaml
USER bellu
EXPOSE 8080
ENTRYPOINT ["bellu-api"]
